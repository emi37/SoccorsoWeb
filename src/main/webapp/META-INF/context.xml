<?xml version="1.0" encoding="UTF-8"?>
<Context path="/SoccorsoWeb">

    <!-- il cookie di sessione non viene inviato nelle richieste partite da altri siti (difesa in più contro il CSRF) -->
    <CookieProcessor className="org.apache.tomcat.util.http.Rfc6265CookieProcessor" sameSiteCookies="lax"/>

    <!--
        Connection pool verso MySQL, gestito da Tomcat (DBCP) e raggiunto via JNDI.
        Si preleva con: new InitialContext().lookup("java:comp/env/jdbc/soccorsoweb")
        (vedi util/DBManager.java e il resource-ref in WEB-INF/web.xml).

        maxTotal      = numero massimo di connessioni aperte contemporaneamente
        maxIdle       = connessioni inutilizzate tenute pronte nel pool
        maxWaitMillis = attesa massima (ms) per una connessione libera, poi errore
        testOnBorrow + validationQuery = scartano le connessioni chiuse da MySQL
                                         dopo un periodo di inattività (wait_timeout)
    -->
    <Resource
        name="jdbc/soccorsoweb"
        type="javax.sql.DataSource"
        auth="Container"
        driverClassName="com.mysql.cj.jdbc.Driver"
        url="jdbc:mysql://localhost:3306/soccorsoweb_db?connectionTimeZone=LOCAL&amp;forceConnectionTimeZoneToSession=false"
        username="root"
        password="12345"
        initialSize="2"
        maxTotal="10"
        maxIdle="5"
        maxWaitMillis="10000"
        validationQuery="SELECT 1"
        testOnBorrow="true"
    />

</Context>
